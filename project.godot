[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemies"
2d_physics/layer_3="Environment"
2d_physics/layer_4="Projectiles"
2d_physics/layer_5="Interactables"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[export]

web/export_type=1
web/vram_texture_compression=true
web/html/custom_html_shell=""
web/html/head_include=""
web/html/canvas_resize_policy=2
web/html/focus_canvas_on_start=true
web/html/experimental_virtual_keyboard=false
